#!/bin/sh
# Runs the server typecheck and tests before every push. There is no GitHub CI: checks run locally only.
#   - Pushing to develop: a failure BLOCKS the push.
#   - Pushing any other branch: a failure only WARNS, so work in progress can still be pushed.
# Enabled by `npm run hooks:install` (part of `npm run install:all`).
# AI agents: treat the warning as a failure and fix it before calling a task done (AGENTS.md section 10).

# Git passes one line per pushed ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
protected=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/develop" ]; then
    protected=1
  fi
done

echo "[pre-push] server typecheck and tests..."
if npm --prefix server run typecheck --silent && npm --prefix server test --silent; then
  exit 0
fi

if [ "$protected" -eq 1 ]; then
  echo "[pre-push] Server checks failed. Push to develop blocked. Fix the failures, then push again." >&2
  exit 1
fi

cat >&2 <<'MSG'

  ************************************************************
  *  WARNING: server checks FAILED. Pushing anyway.          *
  *  Don't merge (or ask anyone to merge) this branch until  *
  *  `npm test` passes locally.                              *
  ************************************************************

MSG
exit 0
