{
  "name": "certification-store-server",
  "version": "0.1.0",
  "description": "Backend-for-frontend for Certification-Store: Gen AI study plan generation (GitHub Copilot SDK primary, Google Gemini fallback).",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@microsoft/copilot-sdk": "^2.0.1",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  }
}
