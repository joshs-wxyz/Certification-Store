# Copy to `.env` and fill in. Never commit `.env`.

PORT=3000

# ---- Primary provider: GitHub Copilot SDK (@microsoft/copilot-sdk) ----
# A GitHub token for an account/org with an active Copilot license.
# If left empty, the SDK falls back to the locally logged-in GitHub user (gh / Copilot CLI auth),
# which is convenient for local development.
GITHUB_TOKEN=
# Optional: Copilot model id (leave empty to use the Copilot runtime default).
COPILOT_MODEL=

# ---- Fallback provider: Claude API (@anthropic-ai/sdk) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Per-provider generation timeout in milliseconds.
AI_TIMEOUT_MS=120000
